  "description": "Express API for Rocks Rock — serves road rocks, trophy shelf, and journal.",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/app.ts",
    "build": "tsc",
